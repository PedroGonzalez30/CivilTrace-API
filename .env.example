POSTGRES_USER=civiltrace
POSTGRES_PASSWORD=<TU_CONTRASENA_LOCAL>
POSTGRES_DB=civiltrace
POSTGRES_PORT=5432
DATABASE_URL="postgresql://civiltrace:<TU_CONTRASENA_LOCAL>@localhost:5432/civiltrace?schema=public"

# Base de pruebas (servicio baseDatosPruebas de docker-compose; puerto 5434 por defecto)
POSTGRES_PORT_PRUEBAS=5434
DATABASE_URL_PRUEBAS="postgresql://civiltrace:<TU_CONTRASENA_LOCAL>@localhost:5434/civiltrace_pruebas?schema=public"

NODE_ENV=development
JWT_SECRETO=<SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES>

# Portal web del cliente (feature 004)
URL_PORTAL=http://localhost:5173
# Llave de 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO_PORTAL=<LLAVE_DE_32_BYTES_EN_BASE64>

# Correo con Azure Communication Services (opcional en local)
# AZURE_COMUNICACION_ENDPOINT=https://<recurso>.communication.azure.com
# CORREO_REMITENTE=DoNotReply@<dominio>.azurecomm.net
# true: en local los correos (enlace y código) se escriben en la consola de la API
CORREO_EN_CONSOLA=true
