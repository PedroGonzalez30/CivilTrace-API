generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  DUENO
  SUPERVISOR
  TRABAJADOR
}

enum EstadoActividad {
  ACTIVA
  TERMINADA
}

enum EstadoAvance {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Feature 003: el trabajador marca si la foto es un avance del día o la entrega final.
enum TipoAvance {
  DIARIO
  TERMINADO
}

// Asistencia (feature 001): RF-19, RF-27, RF-56, RF-58, RF-60.
enum AlcanceHorario {
  GENERAL
  DIA
}

enum TipoJornada {
  COMPLETA
  RETARDO
  MEDIA_JORNADA
  SALIDA_TEMPRANA
  FALTA
}

enum MotivoAsistencia {
  CITA_MEDICA
  ENFERMEDAD
  PERMISO_PERSONAL
  ASUNTO_FAMILIAR
  OTRO
}

enum EfectoPago {
  PAGO_COMPLETO
  MEDIO_DIA
  SIN_PAGO
}

model Empresa {
  id                     String                 @id @default(cuid())
  nombre                 String
  codigoTrabajadores     String                 @unique
  codigoSupervisores     String                 @unique
  creadaEn               DateTime               @default(now())
  usuarios               Usuario[]
  obras                  Obra[]
  actividades            Actividad[]
  avancesActividad       AvanceActividad[]
  correo                 String?
  descripcion            String?
  direccion              String?
  logoBlob               String?
  // Zona IANA para fechas y horas locales (D-15); se puede cambiar sin migrar datos.
  zonaHoraria            String                 @default("America/Tijuana")
  horariosObra           HorarioObra[]
  credencialesAsistencia CredencialAsistencia[]
  registrosAsistencia    RegistroAsistencia[]
}

model Usuario {
  id                   String                @id @default(cuid())
  nombre               String
  correo               String                @unique
  contrasenaHash       String
  rol                  Rol
  empresaId            String?
  empresa              Empresa?              @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  obrasSupervisadas    Obra[]                @relation("SupervisorDeObra")
  actividadesAsignadas Actividad[]           @relation("ResponsableDeActividad")
  avancesRegistrados   AvanceActividad[]     @relation("AvancesRegistrados")
  tokensRefresco       TokenRefresco[]
  creadoEn             DateTime              @default(now())
  avancesRevisados     AvanceActividad[]     @relation("AvancesRevisados")
  obrasAsignadas       Obra[]                @relation("TrabajadoresDeObra")
  telefono             String?
  fotoBlob             String?
  // Oficio del trabajador (D-18), se captura en el perfil.
  oficio               String?
  horariosCreados      HorarioObra[]         @relation("HorarioCreadoPor")
  credencialAsistencia CredencialAsistencia?
  registrosAsistencia  RegistroAsistencia[]  @relation("AsistenciaDelTrabajador")
  entradasRegistradas  RegistroAsistencia[]  @relation("EntradaRegistradaPor")
  salidasRegistradas   RegistroAsistencia[]  @relation("SalidaRegistradaPor")
  cambiosAsistencia    CambioAsistencia[]

  @@index([empresaId])
}

model Obra {
  id                  String               @id @default(cuid())
  nombre              String
  resumen             String               @default("")
  descripcion         String               @default("")
  direccion           String
  fechaInicio         DateTime             @db.Date
  fechaFinal          DateTime             @db.Date
  cliente             String?
  empresaId           String
  empresa             Empresa              @relation(fields: [empresaId], references: [id])
  supervisorId        String?
  supervisor          Usuario?             @relation("SupervisorDeObra", fields: [supervisorId], references: [id], onDelete: SetNull)
  creadaEn            DateTime             @default(now())
  correoCliente       String?
  trabajadores        Usuario[]            @relation("TrabajadoresDeObra")
  actividades         Actividad[]
  horarios            HorarioObra[]
  registrosAsistencia RegistroAsistencia[]

  @@index([empresaId])
  @@index([supervisorId])
}

model Actividad {
  id             String            @id @default(cuid())
  nombre         String
  // Instrucción para el responsable y fecha de inicio (feature 003, Sup_Agregar1ActividadObra).
  descripcion    String            @default("")
  fechaInicio    DateTime?         @db.Date
  fechaEntrega   DateTime          @db.Date
  fechaTerminada DateTime?         @db.Date
  estado         EstadoActividad   @default(ACTIVA)
  obraId         String
  obra           Obra              @relation(fields: [obraId], references: [id], onDelete: Cascade)
  empresaId      String
  empresa        Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  responsableId  String?
  responsable    Usuario?          @relation("ResponsableDeActividad", fields: [responsableId], references: [id], onDelete: SetNull)
  avances        AvanceActividad[]
  creadaEn       DateTime          @default(now())

  @@index([empresaId])
  @@index([obraId])
  @@index([responsableId])
}

model AvanceActividad {
  id              String       @id @default(cuid())
  comentario      String       @default("")
  fotoBlob        String
  fotoTipo        String       @default("image/jpeg")
  estado          EstadoAvance @default(APROBADO)
  fechaRegistro   DateTime     @default(now())
  actividadId     String
  actividad       Actividad    @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  empresaId       String
  empresa         Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  registradoPorId String?
  registradoPor   Usuario?     @relation("AvancesRegistrados", fields: [registradoPorId], references: [id], onDelete: SetNull)
  // Revisión del supervisor (D-10, feature 003): quién, cuándo y por qué.
  tipo            TipoAvance   @default(DIARIO)
  observacion     String?
  revisadoPorId   String?
  revisadoPor     Usuario?     @relation("AvancesRevisados", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  revisadoEn      DateTime?

  @@index([empresaId])
  @@index([actividadId])
}

model TokenRefresco {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  familiaId  String
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  venceEn    DateTime
  revocadoEn DateTime?
  creadoEn   DateTime  @default(now())

  @@index([usuarioId])
  @@index([familiaId])
}

// Horario de la obra (D-06). Nunca se actualiza ni se borra: cada guardado es una fila nueva,
// así queda el historial. GENERAL vigente = el más reciente; DIA = excepción "solo hoy".
model HorarioObra {
  id                String         @id @default(cuid())
  obraId            String
  obra              Obra           @relation(fields: [obraId], references: [id], onDelete: Restrict)
  empresaId         String
  empresa           Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  alcance           AlcanceHorario
  fecha             DateTime?      @db.Date
  horaEntrada       String
  horaSalida        String
  toleranciaMinutos Int
  diasLaborales     Int[]
  creadoPorId       String
  creadoPor         Usuario        @relation("HorarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn          DateTime       @default(now())

  @@index([obraId, alcance, fecha, creadoEn])
  @@index([empresaId])
}

// Credencial QR permanente del trabajador (D-17). El token va en el QR; la huella SHA-256 es
// lo único que recibe la app del supervisor para validar sin conexión.
model CredencialAsistencia {
  id           String   @id @default(cuid())
  trabajadorId String   @unique
  trabajador   Usuario  @relation(fields: [trabajadorId], references: [id], onDelete: Restrict)
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  token        String   @unique
  tokenHash    String   @unique
  creadaEn     DateTime @default(now())

  @@index([empresaId])
}

// Un registro por trabajador, obra y fecha local. Es evidencia: nunca se borra (IV.6).
model RegistroAsistencia {
  id                     String             @id @default(cuid())
  empresaId              String
  empresa                Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  obraId                 String
  obra                   Obra               @relation(fields: [obraId], references: [id], onDelete: Restrict)
  trabajadorId           String
  trabajador             Usuario            @relation("AsistenciaDelTrabajador", fields: [trabajadorId], references: [id], onDelete: Restrict)
  fecha                  DateTime           @db.Date
  entradaEn              DateTime?          @db.Timestamptz(3)
  entradaLatitud         Decimal?           @db.Decimal(9, 6)
  entradaLongitud        Decimal?           @db.Decimal(9, 6)
  entradaSinConexion     Boolean            @default(false)
  entradaIdLocal         String?            @unique
  entradaRegistradaPorId String?
  entradaRegistradaPor   Usuario?           @relation("EntradaRegistradaPor", fields: [entradaRegistradaPorId], references: [id], onDelete: Restrict)
  salidaEn               DateTime?          @db.Timestamptz(3)
  salidaLatitud          Decimal?           @db.Decimal(9, 6)
  salidaLongitud         Decimal?           @db.Decimal(9, 6)
  salidaSinConexion      Boolean            @default(false)
  salidaIdLocal          String?            @unique
  salidaRegistradaPorId  String?
  salidaRegistradaPor    Usuario?           @relation("SalidaRegistradaPor", fields: [salidaRegistradaPorId], references: [id], onDelete: Restrict)
  tipoJornada            TipoJornada        @default(COMPLETA)
  motivo                 MotivoAsistencia?
  efectoPago             EfectoPago         @default(PAGO_COMPLETO)
  anotacion              String?
  esDiaLaborable         Boolean
  horarioEntrada         String?
  horarioSalida          String?
  toleranciaMinutos      Int?
  creadoEn               DateTime           @default(now())
  actualizadoEn          DateTime           @updatedAt
  cambios                CambioAsistencia[]

  @@unique([trabajadorId, obraId, fecha])
  @@index([empresaId])
  @@index([obraId, fecha])
  @@index([trabajadorId, fecha])
}

// Historial por campo de los cambios a un registro de asistencia (FR-017). Solo se inserta.
model CambioAsistencia {
  id            String             @id @default(cuid())
  registroId    String
  registro      RegistroAsistencia @relation(fields: [registroId], references: [id], onDelete: Restrict)
  campo         String
  valorAnterior String?
  valorNuevo    String?
  motivo        String?
  autorId       String
  autor         Usuario            @relation(fields: [autorId], references: [id], onDelete: Restrict)
  creadoEn      DateTime           @default(now())

  @@index([registroId])
}
