{
  "name": "civiltrace-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "La conexion API del proyecto CivilTrace",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "typecheck": "tsc --noEmit",
    "formatear": "prettier --write .",
    "verificar-formato": "prettier --check .",
    "start": "npm run migrar && node --import tsx src/servidor.ts",
    "migrar": "node node_modules/prisma/build/index.js migrate deploy --config prisma7.config.ts",
    "generar": "prisma generate",
    "postinstall": "prisma generate && npm install --prefix herramientas/lint --no-audit --no-fund",
    "lint": "node herramientas/lint/node_modules/eslint/bin/eslint.js --config herramientas/lint/eslint.config.js src pruebas",
    "lint:instalar": "npm install --prefix herramientas/lint",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroGonzalez30/CivilTrace-API.git"
  },
  "bugs": {
    "url": "https://github.com/PedroGonzalez30/CivilTrace-API/issues"
  },
  "homepage": "https://github.com/PedroGonzalez30/CivilTrace-API#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@azure/communication-email": "^1.1.0",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
