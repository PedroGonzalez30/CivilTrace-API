{
  "name": "civiltrace-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "La conexion API del proyecto CivilTrace",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "typecheck": "tsc --noEmit",
    "formatear": "prettier --write .",
    "verificar-formato": "prettier --check .",
    "start": "node --import tsx src/servidor.ts",
    "generar": "prisma generate",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroGonzalez30/CivilTrace-API.git"
  },
  "bugs": {
    "url": "https://github.com/PedroGonzalez30/CivilTrace-API/issues"
  },
  "homepage": "https://github.com/PedroGonzalez30/CivilTrace-API#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  }
}